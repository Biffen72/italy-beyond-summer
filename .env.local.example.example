# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used to call Claude for supplier profile translation.
# Get this from https://console.anthropic.com/settings/keys
# Never prefix this with NEXT_PUBLIC_, it must not reach the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Secret — bypasses Row Level Security. Server-only, never NEXT_PUBLIC_.
# From Supabase Dashboard → Project Settings → API → "service_role".
# Only for admin scripts / seeding, not used by the app itself.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
